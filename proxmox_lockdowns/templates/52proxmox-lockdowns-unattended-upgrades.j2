// {{ proxmox_lockdowns_managed_marker }}
Unattended-Upgrade::Origins-Pattern {
{% for origin in proxmox_lockdowns_unattended_origins %}
  "{{ origin }}";
{% endfor %}
};
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "false";
{% if proxmox_lockdowns_unattended_mail | length > 0 %}
Unattended-Upgrade::Mail "{{ proxmox_lockdowns_unattended_mail }}";
Unattended-Upgrade::MailReport "on-change";
{% endif %}
